<?xml version="1.0"?>
<!-- =====================================================================
     DELIVERY ROVER  -  differential drive, 4 wheels, 2D LiDAR, front camera
     Designed for Gazebo Harmonic (gz-sim 8) via ros_gz_sim.
     Frame layout:
        base_footprint (z = 0, ground)  ->  base_link (z = 0.22)
     ===================================================================== -->
<robot name="delivery_rover">

  <!-- ============================== Materials ========================= -->
  <material name="dark_grey">
    <color rgba="0.13 0.14 0.16 1.0"/>
  </material>
  <material name="graphite">
    <color rgba="0.07 0.07 0.08 1.0"/>
  </material>
  <material name="orange">
    <color rgba="1.00 0.40 0.02 1.0"/>
  </material>
  <material name="orange_glow">
    <color rgba="1.00 0.55 0.10 1.0"/>
  </material>
  <material name="tyre">
    <color rgba="0.045 0.045 0.05 1.0"/>
  </material>
  <material name="alloy">
    <color rgba="0.72 0.73 0.75 1.0"/>
  </material>
  <material name="sensor_dark">
    <color rgba="0.04 0.05 0.06 1.0"/>
  </material>
  <material name="lens">
    <color rgba="0.02 0.10 0.16 1.0"/>
  </material>

  <!-- ============================== Root frame ======================== -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.22" rpy="0 0 0"/>
  </joint>

  <!-- ============================== Chassis =========================== -->
  <link name="base_link">

    <!-- main hull -->
    <visual name="hull">
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <box size="0.72 0.46 0.16"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>

    <!-- upper deck, orange accent panel -->
    <visual name="deck">
      <origin xyz="0 0 0.14" rpy="0 0 0"/>
      <geometry>
        <box size="0.62 0.40 0.04"/>
      </geometry>
      <material name="orange"/>
    </visual>

    <!-- cargo pod -->
    <visual name="cargo_pod">
      <origin xyz="-0.14 0 0.22" rpy="0 0 0"/>
      <geometry>
        <box size="0.34 0.28 0.12"/>
      </geometry>
      <material name="graphite"/>
    </visual>

    <!-- cargo pod strap -->
    <visual name="cargo_strap">
      <origin xyz="-0.14 0 0.22" rpy="0 0 0"/>
      <geometry>
        <box size="0.345 0.285 0.03"/>
      </geometry>
      <material name="orange"/>
    </visual>

    <!-- front bumper -->
    <visual name="front_bumper">
      <origin xyz="0.38 0 0.0" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.46 0.12"/>
      </geometry>
      <material name="orange"/>
    </visual>

    <!-- rear bumper -->
    <visual name="rear_bumper">
      <origin xyz="-0.38 0 0.0" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.46 0.12"/>
      </geometry>
      <material name="orange"/>
    </visual>

    <!-- side skirts -->
    <visual name="skirt_left">
      <origin xyz="0 0.235 -0.03" rpy="0 0 0"/>
      <geometry>
        <box size="0.60 0.02 0.07"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <visual name="skirt_right">
      <origin xyz="0 -0.235 -0.03" rpy="0 0 0"/>
      <geometry>
        <box size="0.60 0.02 0.07"/>
      </geometry>
      <material name="orange"/>
    </visual>

    <collision name="hull_collision">
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.84 0.46 0.18"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <mass value="14.0"/>
      <inertia ixx="0.29353" ixy="0.0" ixz="0.0"
               iyy="0.86987" iyz="0.0" izz="1.07007"/>
    </inertial>
  </link>

  <!-- ============================== Wheels ============================ -->
  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_left_wheel_link"/>
    <origin xyz="0.24 0.29 -0.10" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="25.0" velocity="30.0"/>
  </joint>
  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_wheel_link"/>
    <origin xyz="-0.24 0.29 -0.10" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="25.0" velocity="30.0"/>
  </joint>
  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_right_wheel_link"/>
    <origin xyz="0.24 -0.29 -0.10" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="25.0" velocity="30.0"/>
  </joint>
  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_wheel_link"/>
    <origin xyz="-0.24 -0.29 -0.10" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="25.0" velocity="30.0"/>
  </joint>

  <link name="front_left_wheel_link">
    <visual name="tyre">
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.12" length="0.08"/>
      </geometry>
      <material name="tyre"/>
    </visual>
    <visual name="hub">
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.055" length="0.085"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.12" length="0.08"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.2"/>
      <inertia ixx="0.00496" ixy="0.0" ixz="0.0"
               iyy="0.00864" iyz="0.0" izz="0.00496"/>
    </inertial>
  </link>

  <link name="rear_left_wheel_link">
    <visual name="tyre">
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.12" length="0.08"/>
      </geometry>
      <material name="tyre"/>
    </visual>
    <visual name="hub">
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.055" length="0.085"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.12" length="0.08"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.2"/>
      <inertia ixx="0.00496" ixy="0.0" ixz="0.0"
               iyy="0.00864" iyz="0.0" izz="0.00496"/>
    </inertial>
  </link>

  <link name="front_right_wheel_link">
    <visual name="tyre">
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.12" length="0.08"/>
      </geometry>
      <material name="tyre"/>
    </visual>
    <visual name="hub">
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.055" length="0.085"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.12" length="0.08"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.2"/>
      <inertia ixx="0.00496" ixy="0.0" ixz="0.0"
               iyy="0.00864" iyz="0.0" izz="0.00496"/>
    </inertial>
  </link>

  <link name="rear_right_wheel_link">
    <visual name="tyre">
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.12" length="0.08"/>
      </geometry>
      <material name="tyre"/>
    </visual>
    <visual name="hub">
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.055" length="0.085"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.12" length="0.08"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.2"/>
      <inertia ixx="0.00496" ixy="0.0" ixz="0.0"
               iyy="0.00864" iyz="0.0" izz="0.00496"/>
    </inertial>
  </link>

  <!-- ============================== LiDAR ============================= -->
  <joint name="lidar_mast_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_mast_link"/>
    <origin xyz="0.20 0 0.24" rpy="0 0 0"/>
  </joint>

  <link name="lidar_mast_link">
    <visual name="mast">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.030" length="0.20"/>
      </geometry>
      <material name="graphite"/>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.0005" ixy="0.0" ixz="0.0"
               iyy="0.0005" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.20 0 0.355" rpy="0 0 0"/>
  </joint>

  <link name="lidar_link">
    <visual name="housing">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.085" length="0.07"/>
      </geometry>
      <material name="sensor_dark"/>
    </visual>
    <visual name="window">
      <origin xyz="0 0 -0.005" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.089" length="0.03"/>
      </geometry>
      <material name="orange_glow"/>
    </visual>
    <visual name="cap">
      <origin xyz="0 0 0.045" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.075" length="0.02"/>
      </geometry>
      <material name="graphite"/>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.4"/>
      <inertia ixx="0.0010" ixy="0.0" ixz="0.0"
               iyy="0.0010" iyz="0.0" izz="0.0016"/>
    </inertial>
  </link>

  <!-- ============================== Camera ============================ -->
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.38 0 0.12" rpy="0 0 0"/>
  </joint>

  <link name="camera_link">
    <visual name="housing">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.13 0.07"/>
      </geometry>
      <material name="sensor_dark"/>
    </visual>
    <visual name="lens">
      <origin xyz="0.028 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.028" length="0.012"/>
      </geometry>
      <material name="lens"/>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="0.000273" ixy="0.0" ixz="0.0"
               iyy="0.000093" iyz="0.0" izz="0.000243"/>
    </inertial>
  </link>

  <!-- ====================== Gazebo Sim plugins ======================== -->
  <gazebo>
    <!-- Differential drive on the two left and two right wheels -->
    <plugin filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>

      <!-- 2 * 0.29 m -->
      <wheel_separation>0.58</wheel_separation>
      <wheel_radius>0.12</wheel_radius>

      <max_linear_acceleration>2.0</max_linear_acceleration>
      <min_linear_acceleration>-2.0</min_linear_acceleration>
      <max_angular_acceleration>3.0</max_angular_acceleration>
      <min_angular_acceleration>-3.0</min_angular_acceleration>
      <max_linear_velocity>1.5</max_linear_velocity>
      <min_linear_velocity>-1.5</min_linear_velocity>
      <max_angular_velocity>2.5</max_angular_velocity>
      <min_angular_velocity>-2.5</min_angular_velocity>

      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <tf_topic>/tf</tf_topic>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
    </plugin>
  </gazebo>

  <!-- 2D LiDAR: 720 rays, 360 degrees, 10 Hz -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <topic>/lidar/scan</topic>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>30.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.005</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- Forward-facing RGB camera, 640x480 @ 10 Hz -->
  <gazebo reference="camera_link">
    <sensor name="camera" type="camera">
      <topic>/camera/image</topic>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <camera>
        <horizontal_fov>1.396</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
        </image>
        <clip>
          <near>0.08</near>
          <far>150</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <!-- High-resolution stills (1920x1080).  always_on=false: Gazebo only
       renders this sensor while something subscribes to /camera/photo, so
       the extra pixels cost nothing during the drive. -->
  <gazebo reference="camera_link">
    <sensor name="photo_camera" type="camera">
      <topic>/camera/photo</topic>
      <update_rate>10</update_rate>
      <always_on>false</always_on>
      <visualize>false</visualize>
      <!-- Tilted up ~3 degrees: at windscreen height the road otherwise fills
           the lower half of the frame and clips the skyline. -->
      <pose>0 0 0 0 -0.05 0</pose>
      <camera>
        <horizontal_fov>1.396</horizontal_fov>
        <image>
          <width>1920</width>
          <height>1080</height>
        </image>
        <clip>
          <near>0.08</near>
          <far>200</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <!-- IMU: heading source.  The four wheels scrub sideways during in-place
       pivots, so wheel odometry over-reports yaw by up to 1.5x; the IMU
       measures true chassis rotation and is fused in waypoint_navigator. -->
  <gazebo reference="base_link">
    <sensor name="imu" type="imu">
      <topic>/imu</topic>
      <update_rate>100</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.0005</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.0005</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.0005</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <!-- ====================== Contact parameters ======================== -->
  <gazebo reference="front_left_wheel_link">
    <mu1>1.1</mu1>
    <mu2>1.1</mu2>
  </gazebo>
  <gazebo reference="rear_left_wheel_link">
    <mu1>1.1</mu1>
    <mu2>1.1</mu2>
  </gazebo>
  <gazebo reference="front_right_wheel_link">
    <mu1>1.1</mu1>
    <mu2>1.1</mu2>
  </gazebo>
  <gazebo reference="rear_right_wheel_link">
    <mu1>1.1</mu1>
    <mu2>1.1</mu2>
  </gazebo>

</robot>
